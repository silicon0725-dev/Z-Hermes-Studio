<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZHS.Desktop.MainWindow"
        Title="Z Hermes Studio"
        Width="1100" Height="720">

    <Grid ColumnDefinitions="320,*">
        <!-- 左：会话 / 任务 两个页签 -->
        <TabControl Grid.Column="0" Margin="8">
            <TabItem Header="会话">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Command="{Binding LoadSessionsCommand}" Content="刷新列表" Margin="0,6,0,0" />
                    <Button DockPanel.Dock="Bottom" Command="{Binding CreateSessionCommand}" Content="新建会话" Margin="0,6,0,0" />
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding WorkspacePath}" Watermark="工作目录" Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SessionId}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="任务">
                <DockPanel x:Name="TasksHost">
                    <Button DockPanel.Dock="Bottom" Command="{Binding RefreshCommand}" Content="刷新任务" Margin="0,6,0,0" />
                    <Button DockPanel.Dock="Bottom" Command="{Binding CreateAndRunCommand}" Content="新建并运行任务" Margin="0,6,0,0" />
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding NewPrompt}" Watermark="任务提示词" Margin="0,6,0,0" AcceptsReturn="True" MinHeight="48" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="11" Opacity="0.7" Margin="0,6,0,0" />
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding JournalText}" IsReadOnly="True" Watermark="执行日志（选中任务查看）" MinHeight="72" MaxHeight="140" FontSize="11" Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.75" />
                                        <TextBlock Text="{Binding TaskId}" FontSize="11" Opacity="0.5" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="产物">
                <DockPanel x:Name="ArtifactsHost">
                    <Button DockPanel.Dock="Bottom" Command="{Binding RefreshCommand}" Content="刷新产物" Margin="0,6,0,0" />
                    <Button DockPanel.Dock="Bottom" Command="{Binding RestoreSelectedVersionCommand}" Content="恢复选中版本" Margin="0,6,0,0" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding SearchCommand}" Content="检索" MinWidth="56" Margin="8,0,0,0" />
                        <TextBox Text="{Binding SearchText}" Watermark="关键词（标题+内容）" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="11" Opacity="0.7" Margin="0,6,0,0" />
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding ContentText}" IsReadOnly="True" Watermark="产物内容预览" FontSize="11" MinHeight="64" MaxHeight="140" Margin="0,6,0,0" TextWrapping="Wrap" AcceptsReturn="True" />
                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MaxHeight="96" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="v" /><Run Text="{Binding Version}" /><Run Text=" · " /><Run Text="{Binding CreatedAtText}" />
                                    <Run Text=" " /><Run Text="{Binding SourceSummary}" Foreground="#888888" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedArtifact}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Text="{Binding SourceSummary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 右：聊天区（虚拟化列表） -->
        <DockPanel Grid.Column="1" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Opacity="0.7" Margin="0,0,0,6" />
            <Button DockPanel.Dock="Top"
                    Command="{Binding CurrentChat.LoadOlderCommand}"
                    IsVisible="{Binding CurrentChat.HasMoreHistory}"
                    Content="加载更早的消息" HorizontalAlignment="Left" Margin="0,0,0,4" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Command="{Binding CurrentChat.SendCommand}" Content="发送" MinWidth="72" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Command="{Binding CurrentChat.SaveArtifactCommand}" Content="存为产物" MinWidth="72" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Command="{Binding CurrentChat.CancelCommand}" Content="取消" MinWidth="72" Margin="8,0,0,0" />
                <TextBox Text="{Binding CurrentChat.InputText, Mode=TwoWay}"
                         Watermark="输入消息（新建会话后可发送）"
                         MinHeight="56" AcceptsReturn="True" />
            </DockPanel>
            <ListBox x:Name="MessageList" ItemsSource="{Binding CurrentChat.Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
